{:paths ["src/clj" "resources"]

 :deps {aero/aero {:mvn/version "1.1.6"}
        com.fzakaria/slf4j-timbre {:mvn/version "0.4.1"}
        com.taoensso/timbre {:mvn/version "6.8.0"}
        integrant/integrant {:mvn/version "1.0.1"}
        org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        ring/ring-jetty-adapter {:mvn/version "1.15.5"}}

 :aliases {:run {:main-opts ["-m" "clj-template.core"]}
           :outdated {:deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}
                             org.slf4j/slf4j-nop {:mvn/version "1.7.36"}}
                      ;; antq uses slf4j 1.7; nop binding only silences its warning
                      :main-opts ["-m" "antq.core" "--exclude=org.slf4j/slf4j-nop"]}
           :fmt {:deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
                 :main-opts ["-m" "cljfmt.main"]}
           :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}
                          org.clojure/clojure {:mvn/version "1.12.6"}}
                   :ns-default build}
           :dev {:extra-paths ["dev/src"]
                 :extra-deps {integrant/repl {:mvn/version "0.5.1"}
                              nrepl/nrepl {:mvn/version "1.7.0"}}
                 :exec-fn user/go-with-nrepl}

           :test {:extra-paths ["test"]
                  :extra-deps {clj-http/clj-http {:mvn/version "3.13.1"}
                               io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                                     :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}}}
